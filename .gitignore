# Private local state and credentials; applies in the archived tree as well.
/.local/
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
config.yaml
.claude/

# Rebuildable or host-specific products, including retained legacy dependencies.
node_modules/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.vite/
dist/
build/
bin/
*.egg-info/
*.log
coverage/
htmlcov/
.coverage
playwright-report/
test-results/
.DS_Store

# Runtime data is never an engineering knowledge source.
/data/
/artifacts/
/tmp/
/legecy/data/
/legecy/tmp/
/legecy/experiments/**/data
/legecy/experiments/**/artifacts
/legecy/config/*.yaml
!/legecy/config/*.example.yaml
